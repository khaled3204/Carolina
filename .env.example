# Required in production — random secret for admin sessions
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL (used in password-reset emails)
SITE_URL=https://your-carolina-site.vercel.app

# Gmail for password reset + sign-in codes (use an App Password, not your normal password)
# Account: shop.carolina.eg@gmail.com
GMAIL_USER=shop.carolina.eg@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# REQUIRED on Vercel — without this, orders, stock, products, and passwords will disappear
# Create a Blob store in the Vercel dashboard → Storage → Blob → copy the token
BLOB_READ_WRITE_TOKEN=

# Kashier — needed for Card payment to work. See PAYMENT_SETUP_GUIDE.md
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_MODE=test
